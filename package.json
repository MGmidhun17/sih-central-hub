{
  "name": "hackrepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-routes.mjs && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "bootstrap-admin": "node --env-file=.env.local --import tsx scripts/bootstrap-admin.ts",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0",
    "zod": "^4.0.0",
    "lucide-react": "^0.468.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "tsx": "^4.20.0"
  },
  "type": "module"
}
